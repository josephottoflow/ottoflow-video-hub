{
  "name": "ottoflow-video-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "studio": "npx remotion studio src/remotion/index.ts --port=3001",
