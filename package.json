    "worker": "tsx src/workers/render-worker.ts",
    "worker:advanced": "tsx src/workers/advanced-worker.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "validate-env": "tsx src/cli/validate-env.ts"
  },
  "dependencies": {
