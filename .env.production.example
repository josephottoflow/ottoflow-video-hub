# ============================================================
# Ottoflow Video Hub — Production (Vercel) Environment
# Copy these into your Vercel dashboard → Settings → Environment Variables
# ============================================================

# ── Cloud Postgres (Neon) ─────────────────────────────────────
# Get at: https://neon.tech → New Project → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Cloud Redis (Upstash) ─────────────────────────────────────
# Get at: https://console.upstash.com → New Database → Redis URL
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ── Anthropic / Claude API ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google API ───────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GOOGLE_SPREADSHEET_ID=1xxx...
GOOGLE_DRIVE_OUTPUTS_ID=1xxx...

# ── ElevenLabs TTS ───────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── D-ID Lipsync ─────────────────────────────────────────────
D_ID_API_KEY=xxx:xxx

# ── Telegram Approval ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxx:xxx
TELEGRAM_CHAT_ID=xxx
TELEGRAM_APPROVAL_TIMEOUT_MS=1800000

# ── Pexels ───────────────────────────────────────────────────
PEXELS_API_KEY=xxx

# ── n8n ──────────────────────────────────────────────────────
N8N_API_KEY=xxx
N8N_BASE_URL=https://xxx.app.n8n.cloud
N8N_PROJECT_ID=xxx

# ── Worker concurrency (set on local machine, not Vercel) ────
# WORKER_CONCURRENCY=1
