# ============================================
# TikTok Product Video Factory — Environment
# ============================================

# === Google Sheets API ===
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# === Ollama (Local AI) ===
# Install Ollama: https://ollama.com/download
# Then run: ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === ElevenLabs TTS ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Telegram Approval Bot ===
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Find your chat_id from the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT_MS=300000

# === TikTok Scraper ===
TIKTOK_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1
TIKTOK_MAX_RETRIES=3

# === App Settings ===
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
VIDEO_FORMAT=mp4
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
