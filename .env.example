# ============================================
# Ottoflow Video Hub — Environment
# ============================================

# === PostgreSQL (system brain) ===
DATABASE_URL=postgresql://ottoflow:ottoflow@localhost:5432/ottoflow

# === Redis / BullMQ (queue) ===
REDIS_URL=redis://localhost:6379

# === Worker ===
WORKER_CONCURRENCY=2

# === Google Sheets API (editor layer — hooks/scripts) ===
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# === Ollama (Local AI) ===
# Install Ollama: https://ollama.com/download
# Then run: ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === ElevenLabs TTS (voiceover narration) ===
# Get key: https://elevenlabs.io → Profile → API Keys
# Voice IDs: https://elevenlabs.io/voice-library (default = Rachel)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === useapi.net — Google Flow (Veo 3.1 Lite, primary video gen) ===
# 1. Sign up at https://useapi.net and get your API token from Dashboard
# 2. Add your Google account: POST /accounts with your Google cookies (one-time setup)
# 3. Ensure your Google account has Google AI Pro ($20/mo) or Ultra for video gen
# Model: veo-3.1-lite = 5 credits (~$0.025/video), 8s clips that loop in Remotion
# Docs: https://useapi.net/docs/api-google-flow-v1
USEAPI_TOKEN=
USEAPI_GOOGLE_FLOW_EMAIL=

# === D-ID Lipsync (talking head for insight scene) ===
# Free tier: 20 videos/month. Sign up: https://studio.d-id.com
D_ID_API_KEY=

# === Telegram Approval Bot ===
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Find your chat_id from the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT_MS=1800000

# === TikTok Scraper ===
TIKTOK_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1
TIKTOK_MAX_RETRIES=3

# === Cloudflare R2 (video/clip/image storage — replaces Google Drive) ===
# 1. Cloudflare dashboard → R2 → Create bucket
# 2. R2 → Manage R2 API tokens → Create token (Object Read & Write)
# 3. Enable public access on bucket → copy the public URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=ottoflow-videos
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# === Jamendo Music API (CC-licensed background music) ===
# Free API key from https://devportal.jamendo.com → My Applications → Register
JAMENDO_CLIENT_ID=

# === App Settings ===
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
VIDEO_FORMAT=mp4
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
